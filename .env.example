# ==========================================
# REQUIRED CONFIGURATION
# ==========================================

# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Client ID (Discord Developer Portal -> General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Default prefix for text commands (e.g. !play, !stop)
PREFIX=!

# Port for 24/7 HTTP health-check keep-alive server (defaults to 3000)
PORT=3000

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================

# Optional: Guild ID for instant slash command registration.
# Leave blank to deploy globally across all servers.
GUILD_ID=

# Spotify API credentials (enables Spotify track/album/playlist conversion)
# Create a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Tenor GIF API key (optional)
TENOR_API_KEY=

# Cloud Database URL for 24/7 state persistence across Render container redeploys
# Supports Supabase / Neon / Turso REST endpoint
DATABASE_URL=

# YouTube Cookies (resolves datacenter IP bot challenges on Render/cloud hosts)
# Either paste the raw Netscape cookies text into YOUTUBE_COOKIES or provide file path
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_PATH=

# Optional Proxy URL (HTTP/HTTPS/SOCKS5) for routing yt-dlp through residential IP
YOUTUBE_PROXY=
