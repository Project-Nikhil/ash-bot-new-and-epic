# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (From Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Optional: Guild/Server ID for instant slash command registration during development.
# If omitted or left blank, commands will register globally (can take up to a few minutes to sync).
GUILD_ID=

